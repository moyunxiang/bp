  "tips": [
    {
      "title": "技能间穿插普攻叠印记",
      "text": "技能和普攻都能给人和建筑叠印记，叠满四层引燃，对线和支援时释放技能后多穿插普攻",
      "refs": [
        {
          "bvid": "BV1ve411B7um",
