  "tips": [
    {
      "title": "先存强普再连打两发",
      "text": "强普大约只存在五秒，而后期1技能冷却只有三秒，可以先存好一发强普，敌人靠近时连续打出两发强普作为束缚",
      "refs": [
        {
          "bvid": "BV1bEZLBBEzv",
          "t": 77
        }
      ],
      "sources": 1
    },
    {
      "title": "蓝环额外伤害的判定",
      "text": "蓝环下2技能的额外伤害看释放期间敌人是否在范围内，只要在范围内，释放完后即使远离也会吃到额外伤害",
      "refs": [
        {
          "bvid": "BV1bEZLBBEzv",
          "t": 107
        }
      ],
      "sources": 1
    },
    {
      "title": "草丛放2技能会暴露视野",
      "text": "在草丛里放2技能，蓝环形态会暴露视野，绿环不会",
      "refs": [
        {
          "bvid": "BV1bEZLBBEzv",
          "t": 131
        }
      ],
      "sources": 1
    },
    {
      "title": "先绿环开2技能再切蓝环",
      "text": "想不被发现地开2技能，先用绿环放，随后再切换蓝环增加技能额外伤害",
      "refs": [
        {
          "bvid": "BV1zhXYBRE6j",
          "t": 177
        }
      ],
      "sources": 1
    },
    {
      "title": "被动范围与2技能相同",
      "text": "被动的生效范围与2技能范围相同，敌人即使不在大招范围内，也会受到被动的额外伤害",
      "refs": [
        {
          "bvid": "BV1bEZLBBEzv",
          "t": 155
        }
      ],
      "sources": 1
    },
    {
      "title": "从侧面开2技能",
      "text": "想提高2技能命中率，不要从正面贴近目标，容易被对面开团，实战中从侧面找机会",
      "refs": [
        {
          "bvid": "BV1zhXYBRE6j",
          "t": 170
        }
      ],
      "sources": 1
    },
    {
      "title": "大招主要用来保命",
      "text": "大招虽然能给队友回血，实战中更多作为保命技能使用，压塔消耗到没状态时用大招撤退",
      "refs": [
        {
          "bvid": "BV1bEZLBBEzv",
          "t": 168
        }
      ],
      "sources": 1
    },
    {
      "title": "长按1技能连兵带人打",
      "text": "清线时不要和兵线站在一起以防被消耗，长按1技能等对面进入技能范围，再连人带兵一起打",
      "refs": [
        {
          "bvid": "BV1zhXYBRE6j",
          "t": 250
        }
      ],
      "sources": 1
    },
    {
      "title": "压塔时分割战场",
      "text": "压塔时存强普后用2技能贴近、A1A，可以帮队友分割战场、防止对面清线，没状态后再开大招撤退",
      "refs": [
        {
          "bvid": "BV1zhXYBRE6j",
          "t": 193
        }
      ],
      "sources": 1
    },
    {
      "title": "绿环只在状态差时开",
      "text": "只有队友或自身状态不好时才切绿环，其余情况直接用蓝环增加伤害",
