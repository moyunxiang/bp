{
  "name": "hok-bp",
  "version": "0.1.0",
  "description": "王者荣耀英雄克制关系与智能BP辅助",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch:official": "tsx scripts/fetch-official.ts --refresh",
    "fetch:news": "tsx scripts/fetch-news.ts",
    "fetch:kpl": "tsx scripts/fetch-kpl.ts",
    "build:data": "tsx scripts/build-data.ts",
    "validate": "tsx scripts/validate.ts",
    "backtest": "tsx scripts/backtest.ts",
    "update-data": "tsx scripts/update-data.ts",
    "e2e": "npm run build && playwright test"
  },
  "type": "module",
  "private": "true",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "pinyin-pro": "^3.29.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
